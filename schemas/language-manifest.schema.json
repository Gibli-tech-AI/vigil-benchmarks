{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Vigil Language Coverage Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["manifest_version","runtime_commit","unicode_version","generated_at","packs"],
  "properties": {
    "manifest_version": {"type":"string","const":"1.0"},
    "runtime_commit": {"type":"string","minLength":7,"maxLength":64},
    "package_version": {"type":"string"},
    "unicode_version": {"type":"string"},
    "generated_at": {"type":"string","format":"date-time"},
    "packs": {
      "type":"array",
      "items": {
        "type":"object",
        "additionalProperties": false,
        "required": ["language_tag","script","direction","pack_present","ci_status","validation_status","attack_samples","benign_samples"],
        "properties": {
          "language_tag": {"type":"string","pattern":"^[A-Za-z0-9-]{2,35}$"},
          "script": {"type":"string","minLength":4,"maxLength":40},
          "direction": {"enum":["ltr","rtl","mixed","unknown"]},
          "dialect_or_variant": {"type":"string"},
          "pack_present": {"type":"boolean"},
          "ci_status": {"enum":["dedicated","shared_only","missing","not_applicable"]},
          "validation_status": {"enum":["validated","partial","unvalidated","unsupported"]},
          "attack_samples": {"type":"integer","minimum":0},
          "benign_samples": {"type":"integer","minimum":0},
          "tpr": {"type":"number","minimum":0,"maximum":1},
          "fpr": {"type":"number","minimum":0,"maximum":1},
          "fnr": {"type":"number","minimum":0,"maximum":1},
          "precision": {"type":"number","minimum":0,"maximum":1},
          "confidence_interval": {
            "type":"object",
            "additionalProperties": false,
            "required":["lower","upper"],
            "properties":{"lower":{"type":"number","minimum":0,"maximum":1},"upper":{"type":"number","minimum":0,"maximum":1}}
          },
          "last_validated": {"type":"string","format":"date"},
          "notes": {"type":"string"}
        }
      }
    }
  }
}